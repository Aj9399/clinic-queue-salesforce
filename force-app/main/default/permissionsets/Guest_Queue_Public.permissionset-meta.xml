<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Guest Queue Public</label>
    <description>Minimal access for the public site guest user: read doctors, create/read their own appointment via a narrow Apex layer. Never grants QueueController access, which returns every patient's name and phone number.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Doctor__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Appointment__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <classAccesses>
        <apexClass>BookingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PublicStatusController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
